# ============================================================
# Vendí — Variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NUNCA commitees .env.local
# ============================================================

# --- Supabase (backend principal: DB + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (modelo de CRÉDITOS: key PROPIA de Vendí, server-side) ---
# Esta es la key única de Vendí con billing real. NUNCA va al browser.
# La generación corre server-side en /api/generations.
GOOGLE_API_KEY=

# --- Observabilidad (opcional en MVP) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Culqi (pasarela de pago — Perú/soles/Yape). Pendiente de credenciales ---
# CULQI_PUBLIC_KEY=
# CULQI_SECRET_KEY=
# CULQI_WEBHOOK_SECRET=

# --- Fase 2 (no requeridas en MVP) ---
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=
