# ============================================================
# Vendí — Variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NUNCA commitees .env.local
# ============================================================

# --- Supabase (backend principal: DB + Storage; RLS vivo via integración Clerk) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (auth: login + verificación). Integración nativa third-party auth con Supabase. ---
# CLERK_SECRET_KEY es server-side, NUNCA va al browser. Sin valores acá: cargar en .env.local / Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Routing de Clerk (deben coincidir con las rutas catch-all de la app y el proxy).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Google Gemini (modelo de CRÉDITOS: key PROPIA de Vendí, server-side) ---
# Esta es la key única de Vendí con billing real. NUNCA va al browser.
# La generación corre server-side en /api/generations.
GOOGLE_API_KEY=

# --- Observabilidad (opcional en MVP) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Whop (RIEL DE COBRO ACTIVO desde 2026-09-04 — USD, Merchant of Record) ---
# Reemplaza a Mercado Pago. Cobra en dólares con adaptive pricing (el comprador
# ve su moneda local) y trae mercado_pago + yape adentro del checkout.
# Cuenta de Vendí: biz_k4v3iljkFYxhCO.
#
# WHOP_API_KEY — API key de CUENTA, secreta, server-side. Se crea en
#   whop.com/dashboard/developer > Account API Keys. La usa
#   lib/whop/client.ts para crear checkout configurations. NUNCA al browser.
WHOP_API_KEY=
# WHOP_WEBHOOK_SECRET — secreto de firma del webhook (`ws_...`). Whop lo muestra
#   UNA SOLA VEZ al crear el webhook. Se valida el header `webhook-signature`
#   = v1,base64(HMAC-SHA256("{webhook-id}.{webhook-timestamp}.{raw body}", secret)).
#   Pegarlo TAL CUAL (con el prefijo ws_, sin base64-encodear). NUNCA al browser.
WHOP_WEBHOOK_SECRET=
# WHOP_ACCOUNT_ID — id de la cuenta de Whop que cobra (`biz_...`). Va como
#   account_id en la checkout configuration.
WHOP_ACCOUNT_ID=

# --- Mercado Pago (LEGACY — riel viejo, ya no se usa; se borra en la fase 6) ---
# Riel de cobro definitivo (Culqi/Yape DESCARTADOS). Vendí es single-seller:
# usa SU PROPIO Access Token del panel, NO el OAuth /oauth/token (eso es de
# marketplaces). App de Paolo: id 532027134550190.
#
# MP_ACCESS_TOKEN — secreto, server-side. Empezar con el de PRUEBA (TEST-...)
#   de "Credenciales de prueba"; en prod va el de producción (requiere cuenta
#   verificada). NUNCA al browser.
MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET — clave de firma del webhook (Tus Integraciones > Webhooks).
#   Hay una de prueba y otra de producción; valida el header x-signature.
MP_WEBHOOK_SECRET=
# NEXT_PUBLIC_MP_PUBLIC_KEY — clave pública (cliente). Casi no se usa con
#   Checkout Pro (MP hostea el form), se deja por si se mete un Brick.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# NEXT_PUBLIC_APP_URL — base para back_urls y notification_url del checkout.
#   Ej. http://localhost:3000 en dev, https://vendiapp.vercel.app en prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Shopify (riel de cobro complementario — webhook orders/paid) ---
# El webhook /api/webhooks/shopify acredita créditos cuando un pedido queda pago.
# Igual que Mercado Pago: valida firma + acredita idempotente vía RPC.
#
# SHOPIFY_WEBHOOK_SECRET — secret de firma del webhook. Se valida el header
#   X-Shopify-Hmac-Sha256 = base64(HMAC-SHA256(rawBody, este secret)). Sale del
#   admin de Shopify al crear el webhook (Configuración > Notificaciones >
#   Webhooks muestra una "clave secreta de los webhooks" para la tienda; si el
#   webhook se crea vía una app, es el "API secret key" de la app). NUNCA al browser.
SHOPIFY_WEBHOOK_SECRET=
# (SHOPIFY_SHOP_DOMAIN se removió: la firma HMAC ya garantiza autenticidad y el
#  header X-Shopify-Shop-Domain trae el myshopifyDomain interno, no el principal.)

# --- Fase 2 (no requeridas en MVP) ---
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=
